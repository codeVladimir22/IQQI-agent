# IQQI-AGENT distribution overrides.
#
# Use these while install.iqqi.ai and git.iqqi.ai are being deployed, or when
# testing against a temporary CDN/Worker URL.

# Base endpoint that serves /archive/... fallback ZIPs.
IQQI_INSTALL_BASE_URL=https://install.iqqi.ai

# Clone/update remotes used by scripts/install.sh and scripts/install.ps1.
IQQI_REPO_URL_HTTPS=https://git.iqqi.ai/IQQI-agent.git
IQQI_REPO_URL_SSH=git@git.iqqi.ai:iqqi/IQQI-agent.git

# Example for a temporary Cloudflare workers.dev endpoint:
# IQQI_INSTALL_BASE_URL=https://iqqi-agent-distribution.<account>.workers.dev
